  },
  "toml": {
  },
  "dockerfile": {
  },
  "malva": {
  },
  "markup": {
  },
  "graphql": {
  },
  "kdl": {
  },
  "plugins": [
    "npm:@dprint/typescript@0.96.1",
    "npm:@dprint/json@0.25.2",
    "npm:@dprint/markdown@0.27.0",
    "npm:@dprint/toml@0.9.0",
    "npm:@dprint/dockerfile@0.7.0",
    "https://plugins.dprint.dev/sql-0.4.1.wasm",
    "npm:dprint-plugin-malva@0.16.0",
    "npm:dprint-plugin-markup@0.27.6",
    "npm:dprint-plugin-yaml@0.6.0",
    "npm:dprint-plugin-graphql@0.2.3",
    "npm:@dprint/kdl@0.4.3",
    "npm:@dprint/typstyle@0.5.3",
    "npm:@dprint/nix@0.1.2",
