    "npm:@dprint/toml@0.8.0",
    "npm:@dprint/dockerfile@0.6.0",
    "https://plugins.dprint.dev/sql-0.3.0.wasm",
    "npm:dprint-plugin-malva@0.16.0",
    "npm:dprint-plugin-markup@0.27.5",
    "npm:dprint-plugin-yaml@0.6.0",
    "npm:dprint-plugin-graphql@0.2.3",
    "npm:@kachick/dprint-plugin-kdl@0.4.1",
    "npm:@kachick/dprint-plugin-typstyle@0.5.1",
