{
  "description": "[DEPRECATED #371] Just keeping this file for backward compatibility",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^(\\.(github|gitlab)/)?renovate\\.json[5c]?$/",
        "/^\\.renovaterc(\\.json[5c]?)?$/",
        "/^default\\.json[5c]?$/"
      ],
      "matchStrings": [
        "github>kachick/renovate-config-dprint([/:]?[^#]*)?#(?<currentValue>v?[\\d\\.]+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "kachick/renovate-config-dprint"
    }
  ]
}
