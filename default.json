{
  "description": "Sharable config for dprint",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/dprint.json/", "/dprint.jsonc/", "/.dprint.json/", "/.dprint.jsonc/"],
      "matchStrings": [
        "\"https://plugins\\.dprint\\.dev/(?<pluginName>[^/-]+)-(?<currentValue>[^/-]+?)\\.wasm\""
      ],
      "depNameTemplate": "dprint/dprint-plugin-{{{pluginName}}}",
      "datasourceTemplate": "github-releases",
      "depTypeTemplate": "dprint-plugin"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/dprint.json/", "/dprint.jsonc/", "/.dprint.json/", "/.dprint.jsonc/"],
      "matchStrings": [
        "\"https://plugins\\.dprint\\.dev/(?<user>g-plane)/(?<pluginName>[^/-]+)-(?<currentValue>[^/]+?)\\.wasm\""
      ],
      "depNameTemplate": "{{{user}}}/{{{pluginName}}}",
      "datasourceTemplate": "github-releases",
      "depTypeTemplate": "dprint-plugin"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/dprint.json/", "/dprint.jsonc/", "/.dprint.json/", "/.dprint.jsonc/"],
      "matchStrings": [
        "\"npm:(?<depName>@?[^@\"]+)@(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "npm",
      "depTypeTemplate": "dprint-plugin"
    }
  ],
  "packageRules": [
    {
      "description": "Transferred to upstream dprint org. See https://github.com/dprint/dprint-plugin-typstyle/issues/364",
      "matchDatasources": ["npm"],
      "matchPackageNames": ["@kachick/dprint-plugin-kdl"],
      "replacementName": "@dprint/kdl",
      "replacementVersion": "0.4.3"
    },
    {
      "description": "Transferred to upstream dprint org. See https://github.com/dprint/dprint-plugin-typstyle/issues/364",
      "matchDatasources": ["npm"],
      "matchPackageNames": ["@kachick/dprint-plugin-typstyle"],
      "replacementName": "@dprint/typstyle",
      "replacementVersion": "0.5.3"
    },
    {
      "description": "Transferred to upstream dprint org. See https://github.com/dprint/dprint-plugin-typstyle/issues/364",
      "matchDatasources": ["npm"],
      "matchPackageNames": ["@kachick/dprint-plugin-nix"],
      "replacementName": "@dprint/nix",
      "replacementVersion": "0.1.2"
    },
    {
      "description": "Transferred to upstream dprint org and renamed to @dprint/shuck. See https://github.com/dprint/dprint-plugin-typstyle/issues/364 and https://github.com/dprint/plugins/pull/99",
      "matchDatasources": ["npm"],
      "matchPackageNames": ["@kachick/dprint-plugin-sh"],
      "replacementName": "@dprint/shuck",
      "replacementVersion": "0.2.2"
    },
    {
      "description": "Renamed to @dprint/shuck. See https://github.com/dprint/plugins/pull/99",
      "matchDatasources": ["npm"],
      "matchPackageNames": ["@dprint/sh"],
      "replacementName": "@dprint/shuck",
      "replacementVersion": "0.2.2"
    }
  ]
}
